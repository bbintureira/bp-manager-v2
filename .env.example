VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Email of the admin user (matches the RLS policy on `allowed_emails` server-side).
VITE_ADMIN_EMAIL=admin@example.com
# Bearer token for GET /api/export (endpoint de solo lectura para scripts).
# Generar con `openssl rand -hex 32` y cargarlo en Vercel como EXPORT_TOKEN.
EXPORT_TOKEN=
